---
import Layout from '../layouts/Layout.astro';
import verdeLeaf from '../assets/verde leaf.svg';
---

<Layout>
  <!-- NAV -->
  <header class="nav">
    <div class="nav-inner">
      <a href="/" class="logo">Verde</a>
      <nav aria-label="Hoofdnavigatie">
        <ul class="nav-links">
          <li><a href="#wandeltherapie">Wandeltherapie</a></li>
          <li><a href="#werkwijze">Werkwijze</a></li>
          <li><a href="#over-mij">Over mij</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
      <a href="#contact" class="nav-btn">Plan een gesprek</a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <span class="eyebrow eyebrow-muted">Wandeltherapie Nijmegen</span>
          <h1>Therapie<br/><em>die beweegt</em></h1>
          <p>Stap voor stap werken aan je welzijn – in beweging, in de natuur, op jouw tempo.</p>
          <div class="hero-ctas">
            <a href="#contact" class="btn btn-cream">Maak een afspraak</a>
            <a href="#wandeltherapie" class="btn btn-ghost">Meer lezen</a>
          </div>
        </div>
        <div class="hero-deco" aria-hidden="true">
          <img src={verdeLeaf.src} alt="" class="hero-leaf" />
        </div>
      </div>
    </section>

    <!-- WANDELTHERAPIE -->
    <section id="wandeltherapie" class="section bg-cream">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow eyebrow-green">Wat is wandeltherapie?</span>
          <h2>Gesprekken in beweging</h2>
          <p class="section-lead">Ik merk steeds weer dat gesprekken anders verlopen als we naast elkaar wandelen in plaats van tegenover elkaar zitten. Buiten valt er iets weg – de druk, het gevoel dat je het goed moet doen. De natuur en beweging doen ondertussen hun eigen werk.</p>
        </div>
        <div class="cards">
          <div class="card">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
            </div>
            <h3>Naast elkaar praten</h3>
            <p>Gesprekken verlopen vanzelf soepeler als we naast elkaar wandelen in plaats van tegenover elkaar zitten. De druk valt weg en stiltes mogen er gewoon zijn.</p>
          </div>
          <div class="card">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            </div>
            <h3>Uit je hoofd, in je lijf</h3>
            <p>Wandelen helpt je om uit je hoofd te komen en meer te voelen wat er speelt. Spanning zakt sneller en gedachten worden helderder.</p>
          </div>
          <div class="card">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <h3>Toegankelijk en veilig</h3>
            <p>Buitenpsychologie is niet zweverig en ook niet sportief. We lopen op een rustig tempo, op een plek waar jij je prettig en veilig voelt. Het gesprek staat centraal – de wandeling ondersteunt.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- VOORDELEN -->
    <section class="section bg-pink">
      <div class="container">
        <div class="voordelen-layout">
          <div class="voordelen-header">
            <span class="eyebrow eyebrow-terra">Voordelen</span>
            <h2>Waarom buiten?</h2>
            <p>Bewegen in de natuur heeft aantoonbaar effect op je welzijn – en gesprekken verlopen buiten gewoon anders. Wandeltherapie heeft inmiddels ruimschoots zijn effectiviteit bewezen.</p>
          </div>
          <div class="voordelen-grid">
            <div class="voordeel">
              <div class="voordeel-num">01</div>
              <h3>Minder stress</h3>
              <p>Buiten bewegen verlaagt de aanmaak van stresshormonen en stimuleert gelukshormonen. Je voelt je na een sessie direct beter.</p>
            </div>
            <div class="voordeel">
              <div class="voordeel-num">02</div>
              <h3>Meer energie & focus</h3>
              <p>Natuur heeft een positief effect op je energieniveau, creativiteit, concentratie, slaap en lichamelijke ontspanning.</p>
            </div>
            <div class="voordeel">
              <div class="voordeel-num">03</div>
              <h3>Makkelijker praten</h3>
              <p>Naast elkaar lopen verlaagt de drempel om over moeilijke dingen te praten. Het gevoel dat je het 'goed moet doen' verdwijnt.</p>
            </div>
            <div class="voordeel">
              <div class="voordeel-num">04</div>
              <h3>Dichter bij jezelf</h3>
              <p>Beweging helpt je om uit je hoofd te komen en contact te maken met je eigen gevoelens en lijf – meer in het hier en nu.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WERKWIJZE -->
    <section id="werkwijze" class="section bg-cream">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow eyebrow-green">Werkwijze</span>
          <h2>Hoe het werkt</h2>
          <p class="section-lead">Een traject begint altijd met een vrijblijvend gesprek. Van kennismaking tot afronding begeleid ik je stap voor stap.</p>
        </div>
        <div class="steps">
          <div class="step">
            <div class="step-num">01</div>
            <div class="step-body">
              <h3>Aanmelding & kennismaking</h3>
              <p>Meld je aan via het contactformulier of per mail. Ik neem binnen 5 werkdagen contact op voor een kosteloos telefonisch kennismakingsgesprek, waarin we samen verkennen of wandeltherapie bij jou en je hulpvraag past.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-num">02</div>
            <div class="step-body">
              <h3>Intake</h3>
              <p>De behandeling begint met een intake van 60 tot 90 minuten, doorgaans via beeldbellen. We verkennen je klachten, onderzoeken waar ze vandaan komen en stellen samen een behandelplan op met heldere doelen.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-num">03</div>
            <div class="step-body">
              <h3>Wandelsessies</h3>
              <p>De behandelsessies vinden buiten plaats, rondom Nijmegen en Lent – in een rustig tempo, op een plek waar jij je prettig en veilig voelt. Het gesprek staat centraal, de wandeling ondersteunt.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-num">04</div>
            <div class="step-body">
              <h3>Evaluatie & afsluiting</h3>
              <p>Gedurende het traject evalueren we regelmatig de voortgang. We sluiten af wanneer je doelen behaald zijn – of sturen bij als de situatie daarom vraagt.</p>
            </div>
          </div>
        </div>
        <div class="pricing-note">
          <p><strong>Intake:</strong> €245,04 per 75 min &nbsp;·&nbsp; <strong>Behandeling:</strong> €177,89 per 60 min &nbsp;·&nbsp; Kennismakingsgesprek gratis &nbsp;·&nbsp; Mogelijk (deels) vergoed via basisverzekering (met verwijsbrief)</p>
        </div>
      </div>
    </section>

    <!-- OVER MIJ -->
    <section id="over-mij" class="section bg-green">
      <div class="container">
        <div class="about-layout">
          <div class="about-text">
            <span class="eyebrow eyebrow-cream-muted">Over mij</span>
            <h2>Roëlle Gevers</h2>
            <p class="about-subtitle">GZ-psycholoog & wandeltherapeut</p>
            <p>Mijn naam is Roëlle Gevers, woonachtig in Lent. Ik ben eigenaar van Psychologiepraktijk Verde en werk naast mijn eigen praktijk ook bij een kleinschalige BGGZ-praktijk in Nijmegen. Ik werk als psycholoog sinds 2016 en behaalde in 2021 mijn BIG-registratie als GZ-psycholoog.</p>
            <p>Het idee voor Verde groeide nadat ik zelf ervaarde hoe krachtig een wandelend gesprek buiten in de natuur kan zijn. In 2023 volgde ik een opleiding buitenpsychologie en was meteen verkocht: alles wat binnen kan, kan ook buiten – en soms werkt het beter. Zo ontstond Verde, wat ook letterlijk 'groen' betekent.</p>
            <p>In sessies ben ik open, nieuwsgierig en echt luisterend. Humor en luchtigheid zijn voor mij net zo belangrijk als de ernst van wat er besproken wordt. Ik werk met CGT, ACT, EMDR en schematherapie – altijd met jouw hulpvraag en eigen regie als uitgangspunt.</p>
            <a href="#contact" class="btn btn-cream" style="margin-top: 1.75rem; display: inline-block;">Neem contact op</a>
          </div>
          <div class="cred-card">
            <ul class="cred-list">
              <li>GZ-psycholoog, BIG-geregistreerd</li>
              <li>Gecertificeerd buitenpsycholoog</li>
              <li>CGT · ACT · EMDR · Schematherapie</li>
              <li>Werkzaam als psycholoog sinds 2016</li>
              <li>10 jaar ervaring als psycholoog</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section bg-cream">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow eyebrow-terra">Contact</span>
          <h2>Een eerste stap zetten</h2>
          <p class="section-lead">Nieuwsgierig of wandeltherapie iets voor jou is? Bel of mail voor een vrijblijvend kennismakingsgesprek.</p>
        </div>
        <div class="contact-items">
          <div class="contact-item">
            <span class="contact-label">Email</span>
            <a href="mailto:info@psychologiepraktijkverde.nl">info@psychologiepraktijkverde.nl</a>
          </div>
          <div class="contact-item">
            <span class="contact-label">Telefoon</span>
            <a href="tel:+31643747288">06 43 74 72 88</a>
          </div>
          <div class="contact-item">
            <span class="contact-label">Locatie</span>
            <span>Nijmegen & omstreken</span>
          </div>
          <div class="contact-item">
            <span class="contact-label">Vergoeding</span>
            <span>(Deels) mogelijk via aanvullende verzekering</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="logo logo-light">Verde</span>
          <p>Wandeltherapie & psychologische begeleiding</p>
        </div>
        <nav aria-label="Footernavigatie" class="footer-nav">
          <a href="#wandeltherapie">Wandeltherapie</a>
          <a href="#werkwijze">Werkwijze</a>
          <a href="#over-mij">Over mij</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <p>© 2026 Psychologiepraktijk Verde &nbsp;·&nbsp; KvK 99502305 &nbsp;·&nbsp; BIG-registratie 99929965225 &nbsp;·&nbsp; AGB code praktijk 94069730 &nbsp;·&nbsp; BTW ID NL005390554B25</p>
        <p>Alle verstrekte informatie is vertrouwelijk en valt onder het beroepsgeheim.</p>
      </div>
    </div>
  </footer>
</Layout>
